+static const char *
+imac_v11_dac_validation_name(enum imac_v11_dac_validation validation)
+{
+	switch (validation) {
+	case IMAC_V11_DAC_INVALID:
+		return "invalid-skipped";
+	case IMAC_V11_DAC_RESTORED:
+		return "valid-restored";
+	case IMAC_V11_DAC_RESTORE_MISMATCH:
+		return "restore-mismatch";
+	case IMAC_V11_DAC_UNAVAILABLE:
+	default:
+		return "unavailable";
+	}
+}
