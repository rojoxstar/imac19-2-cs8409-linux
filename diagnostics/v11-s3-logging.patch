+static void imac_v11_log_prepare(struct hda_codec *codec,
+				 struct imac_v11_prepare_diag *diag,
+				 const char *stage, int ret)
+{
+	unsigned int tas_valid;
+
+	codec_info(codec,
+		   "iMac V11 diag: prepare stage=%s ret=%d ch=%u rate=%u pcm_fmt=%d stream_tag=0x%x hda_fmt=0x%x init_error=%d active_streams=0x%x playback_started=%u branch=%s\n",
+		   stage, ret, diag->channels, diag->rate, diag->pcm_format,
+		   diag->stream_tag, diag->hda_format, diag->init_error,
+		   diag->active_streams, diag->playback_started,
+		   diag->channels >= 4 ? "4ch" : "2ch");
+
+	if (diag->channels < 4) {
+		codec_info(codec,
+			   "iMac V11 diag: dac=not-read-this-path validation=not-read-this-path\n");
+	} else if (diag->dac_validation == IMAC_V11_DAC_UNAVAILABLE) {
+		codec_info(codec,
+			   "iMac V11 diag: dac=unavailable validation=unavailable\n");
+	} else {
+		codec_info(codec,
+			   "iMac V11 diag: dac02_stream=0x%02x dac02_fmt=0x%04x dac03_stream=0x%02x dac03_fmt=0x%04x validation=%s\n",
+			   diag->dac02_stream, diag->dac02_format,
+			   diag->dac03_stream, diag->dac03_format,
+			   imac_v11_dac_validation_name(diag->dac_validation));
+	}
+
+	if (diag->prepare_read_valid == IMAC_V11_PREP_READ_ALL) {
+		codec_info(codec,
+			   "iMac V11 diag: coef01_begin=0x%x gpio=0x%x coef01_end=0x%x\n",
+			   diag->coef01_begin, diag->gpio, diag->coef01_end);
+	} else if (diag->prepare_read_valid) {
+		codec_info(codec,
+			   "iMac V11 diag: existing_reads=partial valid=0x%x raw_coef01_begin=0x%x raw_gpio=0x%x raw_coef01_end=0x%x\n",
+			   diag->prepare_read_valid, diag->coef01_begin,
+			   diag->gpio, diag->coef01_end);
+	} else {
+		codec_info(codec, "iMac V11 diag: existing_reads=unavailable\n");
+	}
+
+	tas_valid = diag->tas[0].valid | diag->tas[1].valid |
+		    diag->tas[2].valid | diag->tas[3].valid;
+	if (diag->tas[0].valid == IMAC_V11_TAS_READ_ALL &&
+	    diag->tas[1].valid == IMAC_V11_TAS_READ_ALL &&
+	    diag->tas[2].valid == IMAC_V11_TAS_READ_ALL &&
+	    diag->tas[3].valid == IMAC_V11_TAS_READ_ALL) {
+		codec_info(codec,
+			   "iMac V11 diag: tas d8=%02x,%02x,%02x,%02x,%02x,%02x da=%02x,%02x,%02x,%02x,%02x,%02x dc=%02x,%02x,%02x,%02x,%02x,%02x de=%02x,%02x,%02x,%02x,%02x,%02x\n",
+			   diag->tas[0].power, diag->tas[0].digital,
+			   diag->tas[0].channel, diag->tas[0].volume,
+			   diag->tas[0].analog, diag->tas[0].config,
+			   diag->tas[1].power, diag->tas[1].digital,
+			   diag->tas[1].channel, diag->tas[1].volume,
+			   diag->tas[1].analog, diag->tas[1].config,
+			   diag->tas[2].power, diag->tas[2].digital,
+			   diag->tas[2].channel, diag->tas[2].volume,
+			   diag->tas[2].analog, diag->tas[2].config,
+			   diag->tas[3].power, diag->tas[3].digital,
+			   diag->tas[3].channel, diag->tas[3].volume,
+			   diag->tas[3].analog, diag->tas[3].config);
+	} else if (tas_valid) {
+		codec_info(codec,
+			   "iMac V11 diag: tas=partial valid=%02x,%02x,%02x,%02x\n",
+			   diag->tas[0].valid, diag->tas[1].valid,
+			   diag->tas[2].valid, diag->tas[3].valid);
+	} else {
+		codec_info(codec, "iMac V11 diag: tas=unavailable\n");
+	}
+
+	if (diag->side_read_valid == IMAC_V11_SIDE_READ_ALL) {
+		codec_info(codec,
+			   "iMac V11 diag: side64_14=0x%x side28_05=0x%x side28_04=0x%x\n",
+			   diag->side64_14, diag->side28_05,
+			   diag->side28_04);
+	} else if (diag->side_read_valid) {
+		codec_info(codec,
+			   "iMac V11 diag: side=partial valid=0x%x raw64_14=0x%x raw28_05=0x%x raw28_04=0x%x\n",
+			   diag->side_read_valid, diag->side64_14,
+			   diag->side28_05, diag->side28_04);
+	} else {
+		codec_info(codec, "iMac V11 diag: side=unavailable\n");
+	}
 }
 
