+		playback->ops.open = imac_playback_pcm_open;
+		playback->ops.prepare = imac_playback_pcm_prepare;
+		playback->ops.cleanup = imac_playback_pcm_cleanup;
+		playback->ops.close = imac_playback_pcm_close;
+	}
+
