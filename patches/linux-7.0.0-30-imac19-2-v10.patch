+	if (cs8409_is_imac_amp(codec) && spec->gen.pcm_rec[0]) {
+		struct hda_pcm_stream *playback =
+			&spec->gen.pcm_rec[0]->stream[SNDRV_PCM_STREAM_PLAYBACK];
