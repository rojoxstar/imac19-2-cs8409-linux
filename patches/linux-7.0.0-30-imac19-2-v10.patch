+static int imac_playback_pcm_cleanup(struct hda_pcm_stream *hinfo,
+				     struct hda_codec *codec,
+				     struct snd_pcm_substream *substream)
+{
+	struct cs8409_spec *spec = codec->spec;
+	int ret;
